        },
        "description": "Bean Validation: e-mail inválido e senha fora de 6 caracteres (422).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"nao-e-email\",\n  \"password\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 422\", () => pm.response.to.have.status(422));",
              "pm.test(\"Erros por campo\", () => pm.expect(pm.response.json().errors).to.have.all.keys(\"username\", \"password\"));"
            ]
          }
        }
      ]
    },
