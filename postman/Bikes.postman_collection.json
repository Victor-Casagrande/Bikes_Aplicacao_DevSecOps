{
  "info": {
    "name": "Bikes",
    "description": "API de usuários do projeto Bikes. Execute em ordem (Run collection): o Create salva o id usado nas demais requisições.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Usuarios - Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "usuarios"
          ]
        },
        "description": "Cria um usuário. Salva o id retornado na variável usuarioId.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// e-mail único a cada execução, para não gerar 409",
              "pm.collectionVariables.set(\"username\", `usuario${Date.now()}@bikes.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"usuarioId\", body.id);",
              "pm.test(\"Retorna id, username e role\", () => {",
              "    pm.expect(body.id).to.be.a(\"number\");",
              "    pm.expect(body.username).to.eql(pm.collectionVariables.get(\"username\"));",
              "    pm.expect(body.role).to.eql(\"CLIENTE\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Usuarios - Create username duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "usuarios"
          ]
        },
        "description": "Mesmo username do Create: UsernameUniqueViolationException (409).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"123456\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 409\", () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "Usuarios - Create campos inválidos",
      "request": {
